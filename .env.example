# Copy to .env and fill in. SEC requires a contact email in the User-Agent.
FINSCOPE_SEC_USER_AGENT="FinScope your-name your-email@example.com"
# FINSCOPE_LOG_LEVEL="INFO"
# FINSCOPE_SEC_MAX_REQUESTS_PER_SECOND="8"
# FINSCOPE_DATA_DIR="data"

# LLM (no FINSCOPE_ prefix for the key). Prices are USD per 1M tokens.
OPENAI_API_KEY=""
# FINSCOPE_LLM_MODEL="gpt-6.1-terra"
# FINSCOPE_LLM_INPUT_PRICE_PER_MTOK="1.00"
# FINSCOPE_LLM_OUTPUT_PRICE_PER_MTOK="5.00"

# Telegram alerts from `check`. Leave empty to skip sending.
FINSCOPE_TELEGRAM_BOT_TOKEN=""
FINSCOPE_TELEGRAM_CHAT_ID=""
